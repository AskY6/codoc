type:
  properties:
    name:
      type: string
    origin:
      type: object
      properties:
        country:
          type: string
        region:
          type: string
        altitude:
          type: string
    variety:
      type: string
    processing:
      type: string
    flavorNotes:
      type: array
      items:
        type: string
    body:
      type: string
    roastLevel:
      type: string
    description:
      type: string

data:
  name: "Ethiopia Yirgacheffe"
  origin:
    country: "Ethiopia"
    region: "Yirgacheffe, Sidamo"
    altitude: "1,700 – 2,200m"
  variety: "Heirloom Arabica (landrace)"
  processing: "washed"
  flavorNotes:
    - citrus
    - jasmine
    - bergamot
    - black tea
    - honey
  body: "light, clean, tea-like"
  roastLevel: "medium"
  description:
    $prompt:
      template: "Write a one-sentence tasting note for a specialty coffee named '{name}' from {origin.region}, with flavor notes of {flavorNotes} and a {body} body."

view: |
  # {name}

  <Badge>{processing}</Badge>
  <Badge>{roastLevel} roast</Badge>

  <Highlight variant="info">
  Source: Bean Box – Guide to Ethiopian Yirgacheffee Coffee
  </Highlight>

  ## Origin

  <InfoRow label="Country">{origin.country}</InfoRow>
  <InfoRow label="Region">{origin.region}</InfoRow>
  <InfoRow label="Altitude">{origin.altitude}</InfoRow>
  <InfoRow label="Variety">{variety}</InfoRow>

  ## Flavor Profile

  <InfoRow label="Processing">{processing}</InfoRow>
  <InfoRow label="Body">{body}</InfoRow>
  <InfoRow label="Notes">{flavorNotes}</InfoRow>

  ---

  <AIBlock label="AI Tasting Note">{description}</AIBlock>
