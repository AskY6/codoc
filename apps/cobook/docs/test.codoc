meta:
  data:
    type: object
    properties:
      messages:
        type: array
        description: Claude Code session messages (JSONL entries)
        items:
          type: object
          properties:
            type:
              type: string
              description: "Message type: user, assistant, system, progress,
                file-history-snapshot"
            uuid:
              type: string
            parentUuid:
              type:
                - string
                - "null"
            timestamp:
              type: string
            sessionId:
              type: string
            message:
              type: object
              description: Message payload (role + content)
              properties:
                role:
                  type: string
                content: {}
    required:
      - messages
data:
  messages:
    $source:
      connector: local-file
      path: ""
      parser: jsonl
view: |
  # Session: 40e3c64f-98ee-4957-814e-dcdf648bf655

  <CodataValue path="/messages" />
