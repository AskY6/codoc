{
  "name": "@cobook/local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "codoc": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build": "tsup && pnpm build:ui",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc --project ui/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.2.117",
    "@cobook/compiler": "workspace:*",
    "@cobook/core": "workspace:*",
    "@cobook/parser": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@mdx-js/mdx": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chokidar": "^4.0.0",
    "esbuild": "^0.28.0",
    "hono": "^4.6.0",
    "yaml": "^2.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.117",
    "@tailwindcss/typography": "^0.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "ai": "^6.0.168",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.9",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
