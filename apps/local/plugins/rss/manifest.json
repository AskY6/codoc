{
  "id": "rss",
  "name": "RSS Reader",
  "description": "AI-first RSS — digests, deep dives, and research across feeds.",
  "engines": { "codoc": "^0.x" },
  "activationEvents": ["onWorkspaceKind:rss"],

  "contributes": {
    "sourceProviders": [
      { "scheme": "rss", "entry": "server/source-provider.ts#rssProvider" }
    ],
    "templates": [
      {
        "id": "rss",
        "name": "RSS Reader",
        "description": "AI-first RSS — ask the agent for digests, deep dives, and research across your feeds.",
        "entry": "template/index.ts#rssTemplate"
      }
    ],
    "legacyDetect": { "entry": "server/detect.ts#detectRssWorkspace" },
    "configurationSchema": {
      "type": "object",
      "properties": {
        "defaultSourceIntervalMinutes": { "type": "number", "exclusiveMinimum": 0, "default": 30 },
        "digestCodocPath": { "type": "string", "default": "inbox.codoc" },
        "sourcesDir": { "type": "string", "default": "sources" },
        "autoDigest": { "type": "boolean", "default": true },
        "digestIntervalMinutes": { "type": "number", "exclusiveMinimum": 0, "default": 120 }
      },
      "additionalProperties": false
    },
    "agentInstructions": "agent-prompt.md",

    "mcpTools": [],

    "commands": [
      { "id": "rss.refresh",   "title": "Refresh feeds" },
      { "id": "rss.digest",    "title": "Update digest" },
      { "id": "rss.subscribe", "title": "Subscribe..." }
    ],
    "menus": {
      "workspace.actionBar": [
        { "command": "rss.refresh" },
        { "command": "rss.digest" },
        { "command": "rss.subscribe" }
      ],
      "commandPalette": [
        { "command": "rss.refresh" },
        { "command": "rss.digest" },
        { "command": "rss.subscribe" }
      ]
    },

    "mdxComponents": [
      { "name": "ArticleList", "path": "components/ArticleList.tsx" },
      { "name": "FeedHeader", "path": "components/FeedHeader.tsx" },
      { "name": "SourceBadge", "path": "components/SourceBadge.tsx" },
      { "name": "DigestStats", "path": "components/DigestStats.tsx" },
      { "name": "DigestTop", "path": "components/DigestTop.tsx" },
      { "name": "DigestList", "path": "components/DigestList.tsx" },
      { "name": "DigestTrending", "path": "components/DigestTrending.tsx" }
    ],
    "ui": {
      "homeView": "inbox",
      "hiddenPaths": ["guide.codoc"],
      "secondaryViews": [
        { "id": "rss-subscriptions", "label": "Subscriptions", "icon": "list" },
        { "id": "rss-saved", "label": "Saved", "icon": "bookmark" }
      ]
    }
  }
}
