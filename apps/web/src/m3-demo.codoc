type:
  properties:
    title:
      type: string
    mode:
      type: string
    todo:
      type: object
    derived:
      type: string
    aiSummary:
      type: string

data:
  title: "CoDoc M3 — Extended Loaders"
  mode: "demo"
  todo:
    $source: "https://jsonplaceholder.typicode.com/todos/1"
    ttl: 30
  derived:
    $ref: "/title"
  aiSummary:
    $prompt:
      template: "The document title is '{title}' and it is running in '{mode}' mode. Summarize this in one sentence."

view: |
  # {title}

  This page demonstrates all four loader types working together.

  ---

  ## Literal Loader

  **Mode:** {mode} — a plain literal value embedded in the .codoc data section.

  ## $source Loader (HTTP fetch)

  **API Response:** {todo}

  Fetched from `jsonplaceholder.typicode.com/todos/1` with a 30-second TTL cache.

  ## $ref Loader (internal reference)

  **Derived value:** {derived}

  This field references `/title` via `$ref` — when the title changes, this updates automatically.

  ## $prompt Loader (LLM generation)

  **AI Summary:** {aiSummary}

  Generated by an LLM using a template that interpolates `{title}` and `{mode}` as dependencies.
