type:
  properties:
    title:
      type: string
    importedName:
      type: string
    importedVersion:
      type: string
    importedStatus:
      type: string

data:
  title: "Document A — Cross-Doc Consumer"
  importedName:
    $ref: "[[B.codoc]]/projectName"
  importedVersion:
    $ref: "[[B.codoc]]/version"
  importedStatus:
    $ref: "[[B.codoc]]/status"

view: |
  # {title}

  This document imports fields from **Document B** using cross-document `$ref` syntax.

  ---

  ## Imported from B.codoc

  - **Project Name:** {importedName}
  - **Version:** {importedVersion}
  - **Status:** {importedStatus}

  ---

  *Try `codoc.update("B.codoc", "/projectName", "NewName")` in the console to see cross-doc propagation.*
