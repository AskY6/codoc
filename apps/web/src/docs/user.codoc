type:
  properties:
    name:
      type: string
    email:
      type: string
    role:
      type: string
    recentActivity:
      type: object
    bio:
      type: string

data:
  name: "Alice Zhang"
  email: "alice@example.com"
  role: "Premium"
  recentActivity:
    $source: "https://dummyjson.com/users/5?select=firstName,lastName,email,role,username"
    ttl: 10
  bio:
    $prompt:
      template: "Write a one-sentence bio for a user named '{name}' with role '{role}'."

view: |
  # {name}

  <InfoRow label="Email">{email}</InfoRow>
  <InfoRow label="Role"><Badge>{role}</Badge></InfoRow>

  ---

  ## Linked Account

  <SourceBlock path="recentActivity">{recentActivity}</SourceBlock>

  ---

  <AIBlock label="AI-Generated Bio">{bio}</AIBlock>
