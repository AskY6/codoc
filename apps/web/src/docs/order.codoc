type:
  properties:
    orderId:
      type: string
    quantity:
      type: number
    productName:
      type: string
    productPrice:
      type: number
    userName:
      type: string
    userEmail:
      type: string
    userActivity:
      type: object
    summary:
      type: string

data:
  orderId: "ORD-20240315-001"
  quantity: 2
  productName:
    $ref: "[[product.codoc]]/name"
  productPrice:
    $ref: "[[product.codoc]]/price"
  userName:
    $ref: "[[user.codoc]]/name"
  userEmail:
    $ref: "[[user.codoc]]/email"
  userActivity:
    $ref: "[[user.codoc]]/recentActivity"
  summary:
    $prompt:
      template: "Summarize this order in one sentence: {quantity}x '{productName}' for customer '{userName}'."

view: |
  # Order {orderId}

  <Highlight variant="warning">
  Cross-document `$ref` — pulls fields from **product.codoc** and **user.codoc** in real time.
  </Highlight>

  ## Customer

  <InfoRow label="Name">{userName}</InfoRow>
  <InfoRow label="Email">{userEmail}</InfoRow>

  ### Linked Account

  <SourceBlock path="userActivity">{userActivity}</SourceBlock>

  ## Product

  <InfoRow label="Product">{productName}</InfoRow>
  <InfoRow label="Unit Price"><PriceDisplay>{productPrice}</PriceDisplay></InfoRow>
  <InfoRow label="Quantity">{quantity}</InfoRow>

  ---

  <AIBlock label="AI-Generated Summary">{summary}</AIBlock>
