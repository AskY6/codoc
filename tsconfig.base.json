{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@cobook/core": ["packages/core/src/index.ts"],
      "@cobook/workspace": ["packages/workspace/src/index.ts"],
      "@cobook/service": ["packages/service/src/index.ts"],
      "@cobook/agent": ["packages/agent/src/index.ts"]
    }
  }
}
