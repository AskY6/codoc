codoc: "0.1"
id: user

meta:
  data:
    type: object
    properties:
      name:
        type: string
      role:
        type: string
    required: [name, role]
  component:
    inlineGreeting:
      props:
        type: object
        properties:
          eyebrow:
            type: string
          title:
            type: string
          subtitle:
            type: string
        required: [title]
    dashboardEmbed:
      props:
        type: object
        properties: {}
    remoteGreeting:
      props:
        type: object
        properties:
          eyebrow:
            type: string
          title:
            type: string
          subtitle:
            type: string
        required: [title]

data:
  name:
    $source: static
    value: "Ada"
  role: "editor"

component:
  inlineGreeting:
    $source: inline
    code: |
      (props) =>
        React.createElement("section", { className: "component-card hero-card" }, [
          React.createElement("p", { className: "eyebrow", key: "eyebrow" }, props.eyebrow ?? "Inline"),
          React.createElement("h3", { key: "title" }, props.title ?? "Untitled"),
          React.createElement("p", { className: "muted", key: "subtitle" }, props.subtitle ?? "")
        ])
  dashboardEmbed:
    $source: codoc
    $ref: dashboard
  remoteGreeting:
    $source: remote
    url: "/components/remote-greeting.mjs"
    export: "RemoteGreeting"

view:
  type: stack
  children:
    - type: section
      eyebrow: User
      title: Profile snapshot
      children:
        - type: grid
          columns: 2
          children:
            - type: component
              component: profileHero
              props:
                eyebrow: User
                title: "{data.name}"
                subtitle: "{data.role}"
            - type: markdown
              content: |
                # User

                This profile is resolved from codoc data.
        - type: table
          title: Field values
          columns:
            - key: label
              label: Field
            - key: value
              label: Value
          rows:
            - label: Name
              value: "{data.name}"
            - label: Role
              value: "{data.role}"
    - type: tabs
      tabs:
        - id: runtimes
          label: Runtime components
          children:
            - type: grid
              columns: 2
              children:
                - type: component
                  component: inlineGreeting
                  props:
                    eyebrow: Inline
                    title: "Client runtime"
                    subtitle: "{data.name} can render custom JS."
                - type: component
                  component: remoteGreeting
                  props:
                    eyebrow: Remote
                    title: "Remote module"
                    subtitle: "{data.role} sourced from a static ESM file."
        - id: embeds
          label: Embedded codoc
          children:
            - type: component
              component: dashboardEmbed
    - type: timeline
      items:
        - id: joined
          title: Joined workspace
          meta: Identity
          body: "{data.name} is active as {data.role}."
        - id: coverage
          title: Runtime coverage
          meta: Components
          body: "The view now exercises inline, remote, and codoc component runtimes."
