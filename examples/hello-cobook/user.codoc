codoc: "0.1"
id: user

meta:
  data:
    type: object
    properties:
      name:
        type: string
      role:
        type: string
    required: [name, role]

data:
  name:
    $source: static
    value: "Ada"
  role: "editor"

view:
  type: stack
  children:
    - type: grid
      columns: 2
      children:
        - type: component
          component: profileHero
          props:
            eyebrow: User
            title: "{data.name}"
            subtitle: "{data.role}"
        - type: markdown
          content: |
            # User

            This profile is resolved from codoc data.
    - type: table
      title: Profile snapshot
      columns:
        - key: label
          label: Field
        - key: value
          label: Value
      rows:
        - label: Name
          value: "{data.name}"
        - label: Role
          value: "{data.role}"
