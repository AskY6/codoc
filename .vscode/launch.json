{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": ["Server (Debug)", "Web (Dev)", "Daemon (Debug)"],
      "preLaunchTask": "launch:pre",
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Server (Debug)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --filter @cobook/server dev",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "fullstack", "order": 1 }
    },
    {
      "name": "Web (Dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --filter @cobook/web dev",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "fullstack", "order": 2 }
    },
    {
      "name": "Daemon (Debug)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx tsx watch packages/local-connector/src/daemon/main.ts",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "fullstack", "order": 3 }
    }
  ]
}
